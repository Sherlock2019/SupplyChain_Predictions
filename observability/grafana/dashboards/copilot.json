{
  "uid": "aurelia-scm-copilot",
  "title": "SPARC — Smart Supply Chain Performer Copilot",
  "tags": ["supply-chain", "copilot"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Requests / min", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(rate(copilot_http_requests_total[5m])) * 60"}]},
    {"id": 2, "type": "stat", "title": "5xx error ratio", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percentunit"}},
     "targets": [{"refId": "A", "expr": "sum(rate(copilot_http_requests_total{status=~\"5..\"}[15m])) / clamp_min(sum(rate(copilot_http_requests_total[15m])), 1e-9)"}]},
    {"id": 3, "type": "stat", "title": "Agent runs (24h)", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(increase(copilot_agent_runs_total[24h]))"}]},
    {"id": 4, "type": "stat", "title": "Blocked / denied requests (24h)", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(increase(copilot_auth_denials_total[24h]))"}]},
    {"id": 5, "type": "timeseries", "title": "API p95 latency by route", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"refId": "A", "legendFormat": "{{path}}", "expr": "histogram_quantile(0.95, sum by (le, path) (rate(copilot_http_request_seconds_bucket[5m])))"}]},
    {"id": 6, "type": "timeseries", "title": "Deterministic analyses by workflow", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{kind}}", "expr": "sum by (kind) (increase(copilot_analyses_total[15m]))"}]},
    {"id": 7, "type": "timeseries", "title": "Agent runs by runtime and outcome", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{runtime}} {{outcome}}", "expr": "sum by (runtime, outcome) (increase(copilot_agent_runs_total[15m]))"}]},
    {"id": 8, "type": "timeseries", "title": "Agent run p90 latency", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"refId": "A", "legendFormat": "{{runtime}}", "expr": "histogram_quantile(0.9, sum by (le, runtime) (rate(copilot_agent_run_seconds_bucket[30m])))"}]},
    {"id": 9, "type": "timeseries", "title": "Qwen (vLLM) generation tokens / s", "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "generated", "expr": "sum(rate(vllm:generation_tokens_total[5m]))"},
                 {"refId": "B", "legendFormat": "prompt", "expr": "sum(rate(vllm:prompt_tokens_total[5m]))"}]},
    {"id": 10, "type": "timeseries", "title": "LLM errors and auth denials", "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "llm {{runtime}}", "expr": "sum by (runtime) (increase(copilot_llm_errors_total[15m]))"},
                 {"refId": "B", "legendFormat": "denied {{reason}}", "expr": "sum by (reason) (increase(copilot_auth_denials_total[15m]))"}]}
  ]
}
