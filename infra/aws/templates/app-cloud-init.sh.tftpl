#!/bin/bash
# AWS application VM bootstrap (rendered by Terraform). Provider-specific steps only; the shared deployment logic
# lives in deploy/vm/bootstrap-app.sh inside the release bundle.
set -euo pipefail
exec > >(tee -a /var/log/aurelia-bootstrap.log) 2>&1
echo "[$(date -Is)] AWS bootstrap start"

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y ca-certificates curl jq unzip postgresql-client python3
curl -fsSL https://get.docker.com | sh
if ! command -v aws >/dev/null; then
  curl -fsSLo /tmp/awscliv2.zip https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip
  unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install
fi

# Container stdout/stderr -> CloudWatch Logs (docker logs keeps working through dual logging).
cat > /etc/docker/daemon.json <<'JSON'
{"log-driver": "awslogs", "log-opts": {"awslogs-region": "${region}", "awslogs-group": "${log_group}", "tag": "app/{{.Name}}"}}
JSON
systemctl restart docker

install -d -m 0750 /opt/aurelia
cd /opt/aurelia

echo "Waiting for release bundle s3://${bucket}/releases/${release_version}.tar.gz"
for i in $(seq 1 180); do
  if aws s3 cp "s3://${bucket}/releases/${release_version}.tar.gz" /tmp/release.tar.gz --region "${region}" --only-show-errors; then break; fi
  sleep 20
done
tar -xzf /tmp/release.tar.gz -C /opt/aurelia

# Runtime secrets from Secrets Manager -> .env, plus deployment settings.
aws secretsmanager get-secret-value --secret-id "${secret_id}" --region "${region}" --query SecretString --output text \
  | jq -r 'to_entries[] | "\(.key)=\(.value)"' > .env
cat >> .env <<ENV
APP_ENV=aws-poc
CLOUD_PROVIDER=aws
APP_IMAGE=${app_image}
POSTGRES_HOST=${db_host}
POSTGRES_PORT=5432
POSTGRES_USER=supplychain
POSTGRES_SSL_SUFFIX=?sslmode=require
FLOWISE_DATABASE_SSL=true
FLOWISE_SECURE_COOKIES=true
BASE_DOMAIN=${base_domain}
ACME_EMAIL=${acme_email}
LLM_MODE=${qwen_base_url == "" ? "deterministic" : "qwen"}
QWEN_BASE_URL=${qwen_base_url}
QWEN_MODEL=${qwen_model}
QWEN_METRICS_TARGET=${qwen_metrics_target}
ENABLE_OBSERVABILITY=${enable_observability}
LANGFUSE_INTERNAL_URL=${enable_observability ? "http://langfuse:3000" : ""}
GRAFANA_INTERNAL_URL=${enable_observability ? "http://grafana:3000" : ""}
FLOWISE_ADMIN_EMAIL=admin@aurelia.local
LANGFUSE_ADMIN_EMAIL=admin@aurelia.local
PUBLIC_BASE_URL=https://app.${base_domain}
PUBLIC_FLOWISE_URL=https://flowise.${base_domain}
PUBLIC_LANGGRAPH_URL=https://studio.${base_domain}
PUBLIC_MCP_URL=https://mcp.${base_domain}
PUBLIC_GRAFANA_URL=${enable_observability ? "https://grafana.${base_domain}" : ""}
PUBLIC_LANGFUSE_URL=${enable_observability ? "https://langfuse.${base_domain}" : ""}
BIND_ADDRESS=127.0.0.1
FLOWISE_API_KEY=
FLOWISE_DB_REJECT_UNAUTHORIZED=true
ENV
# RDS regional CA bundle so Flowise (node-postgres) verifies the database certificate and hostname.
echo "FLOWISE_DB_CA_B64=$(curl -fsSL https://truststore.pki.rds.amazonaws.com/${region}/${region}-bundle.pem | base64 -w0)" >> .env
chmod 600 .env

aws ecr get-login-password --region "${region}" | docker login --username AWS --password-stdin "${registry}"
echo "Waiting for image ${app_image}"
for i in $(seq 1 120); do
  if docker pull "${app_image}"; then break; fi
  sleep 30
done

bash /opt/aurelia/deploy/vm/bootstrap-app.sh
echo "[$(date -Is)] AWS bootstrap complete"
