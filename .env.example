# Do not edit by hand for local use: run `python3 scripts/gen-env.py` to create .env with strong random secrets.
# Cloud VMs build the same file from AWS Secrets Manager / Google Secret Manager (see infra/*/templates).
APP_ENV=development
CLOUD_PROVIDER=local
POSTGRES_HOST=postgres
POSTGRES_USER=supplychain
POSTGRES_PASSWORD=<generated>
# Qwen: Ollama on a workstation (vLLM on the cloud GPU VM uses QWEN_BASE_URL=http://<gpu-ip>:8000/v1)
QWEN_BASE_URL=http://host.docker.internal:11435/v1
QWEN_MODEL=qwen2.5-7b-scm
QWEN_API_KEY=<generated>
LLM_MODE=qwen
# Gateway identities (assistant role) and manager role
PLANNER_API_KEY=<generated>
MANAGER_API_KEY=<generated>
FLOWISE_TOOL_KEY=<generated>
LANGGRAPH_TOOL_KEY=<generated>
MCP_TOOL_KEY=<generated>
MCP_CLIENT_KEY=<generated>
# Flowise (FLOWISE_API_KEY / *_ID are written by flowise/bootstrap.py)
FLOWISE_ADMIN_EMAIL=admin@aurelia.local
FLOWISE_ADMIN_PASSWORD=<generated>
FLOWISE_SECRETKEY=<generated>
FLOWISE_JWT_SECRET=<generated>
FLOWISE_JWT_REFRESH_SECRET=<generated>
FLOWISE_SESSION_SECRET=<generated>
FLOWISE_TOKEN_HASH_SECRET=<generated>
FLOWISE_API_KEY=
# SupplyChain Insight AI (scinsight-api :8100). One key per synthetic user; the service stores only SHA-256 hashes and
# derives tenant + roles from the key. Flowise gets ONLY SCI_AGENT_KEY (role agent_service: read, calculate, create
# recommendations; never review). Existing installs: python3 scripts/gen-env.py --add-missing
SCI_AGENT_KEY=<generated>
SCI_PLANNER_KEY=<generated>
SCI_PROCUREMENT_KEY=<generated>
SCI_WAREHOUSE_KEY=<generated>
SCI_LOGISTICS_KEY=<generated>
SCI_QUALITY_KEY=<generated>
SCI_DIRECTOR_KEY=<generated>
SCI_SAP_EXECUTOR_KEY=<generated>
SCI_MLOPS_KEY=<generated>
SCI_OTHER_TENANT_KEY=<generated>
# Written by flowise/scinsight/deploy.py import (Flowise API key "scinsight-flows" + flow ids)
FLOWISE_SCI_API_KEY=
FLOWISE_SCI_CHATFLOW_ID=
FLOWISE_SCI_SUPERVISOR_ID=
# Fixed by docker-compose.yml for scinsight-api (Phase 1): SAP_MODE=synthetic, SAP_WRITE_ENABLED=false (the service refuses
# to start otherwise), HUMAN_APPROVAL_REQUIRED=true, INDUSTRY_SHARING_ENABLED=false, RAG_ENABLED=true
# Observability
GRAFANA_ADMIN_PASSWORD=<generated>
LANGFUSE_INTERNAL_URL=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=<generated pk-lf-...>
LANGFUSE_SECRET_KEY=<generated sk-lf-...>
LANGFUSE_NEXTAUTH_SECRET=<generated>
LANGFUSE_SALT=<generated>
LANGFUSE_ENCRYPTION_KEY=<generated 64 hex>
LANGFUSE_ADMIN_EMAIL=admin@aurelia.local
LANGFUSE_ADMIN_PASSWORD=<generated>
CLICKHOUSE_PASSWORD=<generated>
REDIS_PASSWORD=<generated>
MINIO_PASSWORD=<generated; SeaweedFS S3 secret>
